# Copy to .env for local development. Use Vercel Project Settings for deployed secrets.
# Never put real credentials into source control.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local default uses SQLite. Set this to the provider's pooled PostgreSQL URL for staging/production.
DATABASE_URL=sqlite:///db.sqlite3
DELIVERY_SERVICE_FEE=0.00
QR_TOKEN_MAX_AGE=86400

# Payments (configure only when payment integration is enabled)
ALATPAY_API_KEY=
ALATPAY_BUSINESS_ID=
PAYSTACK_SECRET_KEY=

# Scheduled endpoints
CRON_SECRET=replace-with-a-long-random-secret
